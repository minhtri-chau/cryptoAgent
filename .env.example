# Copy to .env and fill in. .env is gitignored; never commit real values.
# No market-data provider needs a key: the app runs with nothing configured.
# Never put exchange API keys with trading permissions here.

# Optional: override database location (default: data/cryptoagent.db)
CRYPTOAGENT_DB_PATH=

# Optional: where the nightly backup goes (default: %USERPROFILE%\Backups\cryptoAgent). Use a personal location,
# ideally a personal cloud folder or an external drive, never the work OneDrive. Backups contain DefiLlama data
# held under a personal-use accepted risk: keep them private.
CRYPTOAGENT_BACKUP_DIR=
